@PACKAGE_INIT@

set(Terreate_FOUND TRUE)
unset(Terreate_NOT_FOUND_MESSAGE)
set(Terreate_VERSION "@PROJECT_VERSION@")
set(_Terreate_supported_components Core Platform Graphics)
set(_Terreate_core_built "@TERREATE_BUILD_CORE@")
set(_Terreate_platform_built "@TERREATE_BUILD_PLATFORM@")
set(_Terreate_graphics_built "@TERREATE_BUILD_GRAPHICS@")

# Graphics is the only component that owns Vulkan.  A required Graphics
# request must make the dependency failure visible, while an optional Graphics
# request must not make a required Core request fail when Vulkan is absent.
set(_Terreate_graphics_requested FALSE)
set(_Terreate_graphics_required FALSE)
if(Terreate_FIND_COMPONENTS)
  foreach(_Terreate_requested_component IN LISTS Terreate_FIND_COMPONENTS)
    if(_Terreate_requested_component STREQUAL "Graphics")
      set(_Terreate_graphics_requested TRUE)
      if(Terreate_FIND_REQUIRED_Graphics)
        set(_Terreate_graphics_required TRUE)
      endif()
    endif()
  endforeach()
elseif(_Terreate_graphics_built)
  # Without a component list, all built targets are requested and their
  # transitive dependencies are required by the package lookup.
  set(_Terreate_graphics_requested TRUE)
  set(_Terreate_graphics_required TRUE)
endif()

set(_Terreate_graphics_available FALSE)
if(_Terreate_graphics_built AND _Terreate_graphics_requested)
  include(CMakeFindDependencyMacro)
  if(_Terreate_graphics_required)
    find_dependency(Vulkan)
    if(Vulkan_FOUND AND TARGET Vulkan::Vulkan)
      set(_Terreate_graphics_available TRUE)
    endif()
  else()
    find_package(Vulkan QUIET)
    if(Vulkan_FOUND AND TARGET Vulkan::Vulkan)
      set(_Terreate_graphics_available TRUE)
    else()
      set(Terreate_NOT_FOUND_MESSAGE
        "Terreate Graphics is unavailable because Vulkan was not found")
    endif()
  endif()
endif()

# Import Core and Platform when they are built, plus a requested Graphics
# target only when its Vulkan dependency is available.  Keeping component
# exports separate means optional Graphics with no Vulkan target is not
# imported or reported as found alongside Core.
set(_Terreate_import_Core FALSE)
set(_Terreate_import_Platform FALSE)
set(_Terreate_import_Graphics FALSE)
if(NOT Terreate_FIND_COMPONENTS)
  if(_Terreate_core_built)
    set(_Terreate_import_Core TRUE)
  endif()
  if(_Terreate_platform_built)
    set(_Terreate_import_Platform TRUE)
    set(_Terreate_import_Core TRUE)
  endif()
  if(_Terreate_graphics_built AND _Terreate_graphics_available)
    set(_Terreate_import_Graphics TRUE)
    set(_Terreate_import_Core TRUE)
  endif()
else()
  if(_Terreate_core_built)
    set(_Terreate_import_Core TRUE)
  endif()
  if(_Terreate_platform_built)
    set(_Terreate_import_Platform TRUE)
  endif()
  foreach(_Terreate_requested_component IN LISTS Terreate_FIND_COMPONENTS)
    if(_Terreate_requested_component STREQUAL "Graphics" AND
       _Terreate_graphics_available)
      set(_Terreate_import_Graphics TRUE)
      set(_Terreate_import_Core TRUE)
    endif()
  endforeach()
endif()

foreach(_Terreate_component IN ITEMS Core Platform Graphics)
  set(Terreate_${_Terreate_component}_FOUND FALSE)
  if(_Terreate_import_${_Terreate_component})
    set(_Terreate_component_file
      "${CMAKE_CURRENT_LIST_DIR}/Terreate${_Terreate_component}Targets.cmake")
    if(NOT EXISTS "${_Terreate_component_file}")
      set(Terreate_FOUND FALSE)
      set(Terreate_NOT_FOUND_MESSAGE
        "Terreate package targets are missing from ${CMAKE_CURRENT_LIST_DIR}: "
        "Terreate${_Terreate_component}Targets.cmake")
    else()
      include("${_Terreate_component_file}")
      if(TARGET Terreate::${_Terreate_component})
        set(Terreate_${_Terreate_component}_FOUND TRUE)
      endif()
    endif()
  endif()
endforeach()

foreach(_Terreate_component IN LISTS Terreate_FIND_COMPONENTS)
  string(TOUPPER "${_Terreate_component}" _Terreate_component_upper)
  list(FIND _Terreate_supported_components "${_Terreate_component}"
    _Terreate_component_index)
  if(_Terreate_component_index EQUAL -1)
    set(Terreate_${_Terreate_component}_FOUND FALSE)
    set(Terreate_NOT_FOUND_MESSAGE
      "Terreate does not provide requested component '${_Terreate_component}'; "
      "supported components are Core, Platform, and Graphics")
  elseif(NOT Terreate_${_Terreate_component}_FOUND)
    if(_Terreate_component STREQUAL "Graphics" AND
       _Terreate_graphics_built AND NOT _Terreate_graphics_available)
      # Keep the dependency-specific explanation set above for an optional
      # Graphics request.  Required components are finalized by the standard
      # check_required_components() call below.
      if(NOT Terreate_NOT_FOUND_MESSAGE)
        set(Terreate_NOT_FOUND_MESSAGE
          "Terreate Graphics is unavailable because Vulkan was not found")
      endif()
    else()
      set(Terreate_NOT_FOUND_MESSAGE
        "Terreate component '${_Terreate_component}' is disabled in this "
        "installation; reconfigure Terreate with "
        "TERREATE_BUILD_${_Terreate_component_upper}=ON")
    endif()
  endif()
endforeach()

check_required_components(Terreate)
